# .env file for Nodemailer SMTP configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=your_app_password

# Replace the placeholders above with your actual Gmail address and an App Password.
# For Gmail, you must enable 2‑Step Verification and create an App Password.
# Do NOT commit this file to a public repository.
